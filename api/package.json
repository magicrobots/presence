{
  "name": "@presence/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "dev": "tsup src/index.ts --format cjs --out-dir dist --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@presence/types": "*",
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
